# Local FastAPI configuration. Copy this file to backend/.env and fill in real values.
DATABASE_URL=postgresql+psycopg://reelhire:reelhire@localhost:5432/reelhire
FRONTEND_ORIGIN=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Keep this backend-only. Never expose it with a NEXT_PUBLIC_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=openai/gpt-4.1-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=ReelHire

# Optional: raises GitHub API limits for public-repository inspection.
GITHUB_TOKEN=
